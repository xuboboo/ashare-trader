# A 股 T+1 决策台。所有值都有代码内默认值，这里只写你要改的。

# ---- 行情 ----
# 实时快照批量接口（腾讯）与榜单/历史（东财）都是非官方免费源，务必限频。
UNIVERSE_SIZE=300
# 逗号分隔的 6 位代码，无论排名都纳入股票池（你的自选）。
WATCHLIST=
# 轮询间隔（毫秒）。交易时段外引擎自动休眠，不会打接口。
POLL_MS=3000
# 行情距今超过这么多秒，本轮就不出单也不判成交（L1 本身 3 秒一个切片）。
QUOTE_STALE_SEC=30
# true = 只用日频数据（盘前一次出信号），实时链路故障时也会自动降级到这里。
EOD_ONLY=false

# ---- 账簿与风控 ----
# 本方案不下真实委托：PAPER=true 时全部为影子成交。
PAPER=true
CNY_BANKROLL=150000
SIZE_CNY=50000
# 尾盘最多同时开几只、每日最多开仓次数。
K=3
MAX_DAILY_OPENS=4
STOP_LOSS_PCT=3
# 次日开盘高开超过该百分比先卖一半。
GAP_TRIM_PCT=3
# 次日无条件清仓时间（本地时区 Asia/Shanghai）。
FORCE_EXIT_AT=10:00

# ---- 成本（回测与影子盘共用，别骗自己）----
COMMISSION_RATE=0.00025
COMMISSION_MIN=5
STAMP_TAX_RATE=0.0005
TRANSFER_FEE_RATE=0.00001
EXCHANGE_FEE_RATE=0.000068
SLIPPAGE_TICKS=1

# ---- 选股因子 ----
GAIN_MIN_PCT=3
GAIN_MAX_PCT=7
VOLUME_RATIO_MIN=1.5
MIN_AMOUNT_YI=2
MIN_MCAP_YI=60
# 只在回测数据层生效：日线不够这个根数的股票不进样本（fetch-daily）
MIN_LIST_DAYS=60
# 大盘闸门：上证成交额低于此值（亿元）则强制空仓。
INDEX_MIN_AMOUNT_YI=3000

# ---- 决策模型 ----
# factor = 规则打分（默认，毫秒级）；llm 只会额外做盘前情绪与个股 veto，不进 tick 循环。
MODEL=factor
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_API_KEY=
LLM_TIMEOUT_MS=20000

PORT=3005
