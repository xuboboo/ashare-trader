# A 股 T+1 决策台。所有值都有代码内默认值，这里只写你要改的。

# ---- 行情 ----
# 实时快照批量接口（腾讯）与榜单/历史（东财）都是非官方免费源，务必限频。
UNIVERSE_SIZE=300
# 逗号分隔的 6 位代码，无论排名都纳入股票池（你的自选）。
WATCHLIST=
# 轮询间隔（毫秒）。交易时段外引擎自动休眠，不会打接口。
POLL_MS=3000
# 行情距今超过这么多秒，本轮就不出单也不判成交（L1 本身 3 秒一个切片）。
QUOTE_STALE_SEC=30
# true = 只用日频数据（盘前一次出信号），实时链路故障时也会自动降级到这里。
EOD_ONLY=false

# ---- 账簿与风控 ----
# 本方案不下真实委托：PAPER=true 时全部为影子成交。
PAPER=true
# 默认档 15 万；1 万小资金参考档：CNY_BANKROLL=10000 + SIZE_CNY=3300
# ⚠ 小资金档的成本不是 11.6bp：5 元最低佣金双边占 30bp，往返名义 36.9bp、
#   实测约 45bp（一手取整后实际成交金额常小于预算）。已经证伪的策略在这个档上
#   离转正更远，不是更近。回测与门槛必须标明用的是哪一档（参数行会打印名义成本）。
CNY_BANKROLL=150000
SIZE_CNY=50000
# 最多同时开几只、每日最多开仓次数。
K=3
MAX_DAILY_OPENS=4
STOP_LOSS_PCT=3
# 止损模式：fixed = 买入价×(1-STOP_LOSS_PCT%)；atr = 买入价 − ATR_K×ATR₁₄（封底买入价×90%）。
# atr 需要先跑 bun run fetch:daily 生成日线（过期自动回退 fixed）。回测对比见 scripts/atr-sweep.ts。
STOP_MODE=fixed
ATR_K=2.5
ATR_N=14
# 组合级风控闸（只封新开仓，不封退出）：当日亏损相对日初权益达到上限停止开仓，次日恢复
MAX_DAY_LOSS_PCT=3
# 权益自峰值回撤达到上限停止开仓，创新高后自动恢复；0 = 关闭
MAX_DRAWDOWN_PCT=10
# 次日开盘高开超过该百分比先卖一半。
GAP_TRIM_PCT=3
# 次日无条件清仓时间（本地时区 Asia/Shanghai）。
FORCE_EXIT_AT=10:00

# ---- 成本（回测与影子盘共用，别骗自己）----
COMMISSION_RATE=0.00025
COMMISSION_MIN=5
STAMP_TAX_RATE=0.0005
TRANSFER_FEE_RATE=0.00001
EXCHANGE_FEE_RATE=0.000068
SLIPPAGE_TICKS=1

# ---- 选股因子 ----
GAIN_MIN_PCT=3
GAIN_MAX_PCT=7
VOLUME_RATIO_MIN=1.5
MIN_AMOUNT_YI=2
MIN_MCAP_YI=60
# 只在回测数据层生效：日线不够这个根数的股票不进样本（fetch-daily）
MIN_LIST_DAYS=60
# 大盘闸门：上证成交额低于此值（亿元）则强制空仓。
INDEX_MIN_AMOUNT_YI=3000

# ---- 决策模型 ----
# factor = 规则打分（默认，毫秒级、可回测）
# local  = 本地概率模型：bun run train 用本地日线训练（scripts/train-model.ts），
#          与回测同一条出场规则出"扣成本后为正"的概率，零 API 零费用
# jev    = TypeSafe 的 System One 模型（需要 TYPESAFE_AI_API_KEY，无 key 自动降级）
MODEL=factor
# Jev：不生成文本，输入 state + 问题，返回带概率的结构化判断。不配 key 时自动降级回 factor。
TYPESAFE_AI_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai/v1
JEV_MODEL_ID=jev-latest
# 只采纳概率高于此值的候选（local 与 jev 共用这个阈值）
JEV_MIN_PROB=0.55
# 一次请求问几只（共享 state，并行判定）
JEV_MAX_QUESTIONS=20
JEV_TIMEOUT_MS=15000
# 买入决策节奏（毫秒）：开盘后全程决策，每隔这么久做一次买入决策（尾盘不再特殊）。
# 行情仍每 POLL_MS 拉一次；退出管理（止损/高开减半/到点清仓）是纯规则，每轮都跑。
DECIDE_EVERY_MS=30000
# 下面是另一个东西：盘前情绪闸门与个股事件 veto，走通用 chat 接口
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_API_KEY=
LLM_TIMEOUT_MS=20000

PORT=3005
# 监听地址。默认只绑回环 —— 面板上有“清空账本”与“推给券商 sidecar”两个写接口，
# 绑 0.0.0.0 且无口令 = 同一局域网里任何设备都能清你的账本。
# 要局域网/手机直接访问就改成 0.0.0.0（或你的网卡地址），并且必须同时设 API_TOKEN。
API_HOST=127.0.0.1
# 写接口口令（POST /scan /fill /fill/remove /reset /broker/order 全部适用）。
# 留空 = 只允许本机非跨源的写请求。远程面板用 ?token=xxx 传入。
API_TOKEN=
# 本地目录。相对路径永远相对仓库根解析（不跟 cwd 跑），避免双开两套账本。
DATA_DIR=data

# ---- 券商通道（QMT sidecar，可选）----
# 桥接骨架：本进程只与 127.0.0.1 的 sidecar 通信，引擎不会自动下单。
# sidecar 三档：mock（默认，不碰 xtquant）/ dry（连 miniQMT 但不下单）/ live（真实委托，
# 需 QMT_CONFIRM=I-KNOW-THIS-IS-REAL）。详见 docs/COMPLIANCE.md。
QMT_SIDECAR_URL=http://127.0.0.1:3011
QMT_TOKEN=
# 双重安全开关：PAPER=true 时主服务仍会拒绝 /broker/order。
BROKER_SUBMIT_ENABLED=false
